<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="rootPane" prefHeight="700.0" prefWidth="1200.0" style="-fx-background-color: #f8fafc;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pms.ui.MainDashboardController">
    <!-- Left Navigation Sidebar -->
    <left>
        <VBox prefWidth="240.0" spacing="10.0" style="-fx-background-color: #1e293b; -fx-padding: 20 15 20 15;">
            <children>
                <VBox spacing="4.0" style="-fx-padding: 0 0 20 10;">
                    <children>
                        <Label text="IMS Portal" textFill="#f8fafc">
                            <font>
                                <Font name="System Bold" size="22.0" />
                            </font>
                        </Label>
                        <Label text="Inventory Management" textFill="#94a3b8">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <Button fx:id="navDashboardButton" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleNavDashboard"
                        style="-fx-background-color: #334155; -fx-text-fill: #f8fafc; -fx-font-weight: bold; -fx-padding: 10 15; -fx-background-radius: 6; -fx-cursor: hand;"
                        text="📊  Dashboard" />

                <Button fx:id="navProductsButton" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleNavProducts"
                        style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-padding: 10 15; -fx-background-radius: 6; -fx-cursor: hand;"
                        text="📦  Products" />

                <Button fx:id="navInventoryButton" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleNavInventory"
                        style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-padding: 10 15; -fx-background-radius: 6; -fx-cursor: hand;"
                        text="🏢  Inventory &amp; Stock" />

                <Button fx:id="navSalesButton" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleNavSales"
                        style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-padding: 10 15; -fx-background-radius: 6; -fx-cursor: hand;"
                        text="🛒  Sales (POS)" />

                <Button fx:id="navUsersButton" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleNavUsers"
                        style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-padding: 10 15; -fx-background-radius: 6; -fx-cursor: hand;"
                        text="👥  User Accounts" />

                <VBox VBox.vgrow="ALWAYS" />

                <Button fx:id="navLogoutButton" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleLogout"
                        style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 15; -fx-background-radius: 6; -fx-cursor: hand;"
                        text="🚪  Sign Out" />
            </children>
        </VBox>
    </left>

    <!-- Top Header Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-background-color: #ffffff; -fx-padding: 0 25; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
            <children>
                <Label fx:id="userWelcomeLabel" text="Welcome, User" textFill="#0f172a">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <HBox HBox.hgrow="ALWAYS" />
                <Label fx:id="userRoleBadge" text="ADMIN" textFill="#3b82f6"
                       style="-fx-background-color: #eff6ff; -fx-padding: 5 12; -fx-background-radius: 12; -fx-font-weight: bold; -fx-font-size: 12;" />
            </children>
        </HBox>
    </top>

    <!-- Center Content Area -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-padding: 20;">
            <children>
                <!-- Default Home Dashboard View -->
                <VBox fx:id="dashboardView" spacing="20.0">
                    <children>
                        <Label text="Executive Overview" textFill="#0f172a">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>

                        <!-- Metric Summary Cards -->
                        <HBox spacing="15.0">
                            <children>
                                <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                                    <children>
                                        <Label text="Total Active Products" textFill="#64748b" style="-fx-font-size: 13;" />
                                        <Label fx:id="totalProductsLabel" text="0" textFill="#0284c7">
                                            <font>
                                                <Font name="System Bold" size="28.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>

                                <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #fecaca; -fx-border-radius: 8;">
                                    <children>
                                        <Label text="Low-Stock Alerts" textFill="#dc2626" style="-fx-font-size: 13; -fx-font-weight: bold;" />
                                        <Label fx:id="lowStockAlertsLabel" text="0" textFill="#dc2626">
                                            <font>
                                                <Font name="System Bold" size="28.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>

                                <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                                    <children>
                                        <Label text="Active Warehouses" textFill="#64748b" style="-fx-font-size: 13;" />
                                        <Label fx:id="totalWarehousesLabel" text="0" textFill="#10b981">
                                            <font>
                                                <Font name="System Bold" size="28.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>

                                <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                                    <children>
                                        <Label text="Active Suppliers" textFill="#64748b" style="-fx-font-size: 13;" />
                                        <Label fx:id="totalSuppliersLabel" text="0" textFill="#8b5cf6">
                                            <font>
                                                <Font name="System Bold" size="28.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- Low Stock Warning Table -->
                        <VBox spacing="10.0" VBox.vgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                            <children>
                                <Label text="⚠️ Low-Stock Attention Required" textFill="#b91c1c">
                                    <font>
                                        <Font name="System Bold" size="15.0" />
                                    </font>
                                </Label>
                                <TableView fx:id="lowStockTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 4;">
                                    <columns>
                                        <TableColumn fx:id="lowStockSkuCol" prefWidth="150.0" text="SKU" />
                                        <TableColumn fx:id="lowStockNameCol" prefWidth="350.0" text="Product Name" />
                                        <TableColumn fx:id="lowStockReorderCol" prefWidth="180.0" text="Reorder Threshold" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>
</BorderPane>

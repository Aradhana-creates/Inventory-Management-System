<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="650.0" prefWidth="920.0" spacing="15.0" style="-fx-background-color: transparent;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pms.ui.ProductController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <VBox>
                    <children>
                        <Label text="Product Catalogue" textFill="#0f172a">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                        <Label text="Manage and search items in inventory" textFill="#64748b" style="-fx-font-size: 13;" />
                    </children>
                </VBox>
                <HBox HBox.hgrow="ALWAYS" />
                <TextField fx:id="searchField" promptText="Search SKU, name, description..." prefWidth="260.0" onAction="#handleSearch"
                           style="-fx-pref-height: 36; -fx-background-radius: 4;" />
                <Button onAction="#handleSearch" style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-pref-height: 36; -fx-background-radius: 4; -fx-cursor: hand;"
                        text="🔍 Search" />
            </children>
        </HBox>

        <HBox spacing="15.0" VBox.vgrow="ALWAYS">
            <children>
                <!-- Products Table -->
                <VBox HBox.hgrow="ALWAYS" spacing="10.0" style="-fx-background-color: #ffffff; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                    <children>
                        <TableView fx:id="productTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 4;">
                            <columns>
                                <TableColumn fx:id="idCol" prefWidth="50.0" text="ID" />
                                <TableColumn fx:id="skuCol" prefWidth="90.0" text="SKU" />
                                <TableColumn fx:id="nameCol" prefWidth="180.0" text="Name" />
                                <TableColumn fx:id="categoryCol" prefWidth="120.0" text="Category" />
                                <TableColumn fx:id="priceCol" prefWidth="90.0" text="Unit Price" />
                                <TableColumn fx:id="reorderCol" prefWidth="75.0" text="Reorder" />
                                <TableColumn fx:id="activeCol" prefWidth="65.0" text="Active" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>

                <!-- Product Form -->
                <VBox prefWidth="320.0" spacing="12.0" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                    <children>
                        <Label text="Product Details" textFill="#0f172a">
                            <font>
                                <Font name="System Bold" size="15.0" />
                            </font>
                        </Label>

                        <VBox spacing="4.0">
                            <children>
                                <Label text="SKU *" textFill="#334155" style="-fx-font-weight: bold; -fx-font-size: 12;" />
                                <TextField fx:id="skuField" promptText="e.g. EL-001" style="-fx-pref-height: 32;" />
                            </children>
                        </VBox>

                        <VBox spacing="4.0">
                            <children>
                                <Label text="Product Name *" textFill="#334155" style="-fx-font-weight: bold; -fx-font-size: 12;" />
                                <TextField fx:id="nameField" promptText="Enter product name" style="-fx-pref-height: 32;" />
                            </children>
                        </VBox>

                        <VBox spacing="4.0">
                            <children>
                                <Label text="Category" textFill="#334155" style="-fx-font-weight: bold; -fx-font-size: 12;" />
                                <ComboBox fx:id="categoryComboBox" maxWidth="Infinity" promptText="Select category" style="-fx-pref-height: 32;" />
                            </children>
                        </VBox>

                        <HBox spacing="10.0">
                            <children>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="Unit Price *" textFill="#334155" style="-fx-font-weight: bold; -fx-font-size: 12;" />
                                        <TextField fx:id="unitPriceField" promptText="0.00" style="-fx-pref-height: 32;" />
                                    </children>
                                </VBox>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="Reorder Level *" textFill="#334155" style="-fx-font-weight: bold; -fx-font-size: 12;" />
                                        <TextField fx:id="reorderLevelField" promptText="0" style="-fx-pref-height: 32;" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <VBox spacing="4.0" VBox.vgrow="ALWAYS">
                            <children>
                                <Label text="Description" textFill="#334155" style="-fx-font-weight: bold; -fx-font-size: 12;" />
                                <TextArea fx:id="descriptionField" promptText="Optional notes or description" prefRowCount="3" wrapText="true" VBox.vgrow="ALWAYS" />
                            </children>
                        </VBox>

                        <VBox spacing="8.0">
                            <children>
                                <HBox spacing="8.0">
                                    <children>
                                        <Button fx:id="addButton" maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#handleAddProduct"
                                                style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 34; -fx-background-radius: 4; -fx-cursor: hand;"
                                                text="➕ Add" />
                                        <Button fx:id="updateButton" maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#handleUpdateProduct"
                                                style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 34; -fx-background-radius: 4; -fx-cursor: hand;"
                                                text="✏️ Update" />
                                    </children>
                                </HBox>
                                <HBox spacing="8.0">
                                    <children>
                                        <Button fx:id="deleteButton" maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#handleDeleteProduct"
                                                style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 34; -fx-background-radius: 4; -fx-cursor: hand;"
                                                text="🗑 Deactivate" />
                                        <Button fx:id="clearButton" maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#handleClearForm"
                                                style="-fx-background-color: #e2e8f0; -fx-text-fill: #475569; -fx-pref-height: 34; -fx-background-radius: 4; -fx-cursor: hand;"
                                                text="Clear" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>
